# Match upstream C layout; see docs/style.md and DEC-M0-T005.
# Formatting never changes ownership or runtime ordering.
BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 0
BreakBeforeBraces: Linux
AllowShortIfStatementsOnASingleLine: AllIfsAndElse
AllowShortLoopsOnASingleLine: true
AllowShortFunctionsOnASingleLine: Inline
SortIncludes: Never
PointerAlignment: Right
